{
  "name": "claurim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Claurim: a browser-playable open-world action RPG. One deterministic sim, multiple hosts.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate_content.ts && tsx scripts/validate_assets.ts && tsx scripts/validate_blender_world.ts && tsx scripts/check_ip.ts",
    "validate:assets": "tsx scripts/validate_assets.ts",
    "validate:blender-world": "tsx scripts/validate_blender_world.ts",
    "export:blender-world": "tsx scripts/export_blender_world.ts",
    "headless": "tsx src/headless/run.ts",
    "server": "tsx src/server/ws_host.ts",
    "qa:ws": "tsx scripts/qa_ws_smoke.ts",
    "net:bench": "tsx src/headless/network_bench.ts",
    "net:proxy": "tsx scripts/ws_impairment_proxy.ts",
    "mp:bench": "tsx src/headless/mp_bench.ts",
    "ai:bench": "tsx src/headless/mp_bench.ts runs=3 policy=compare",
    "combat:bench": "tsx src/headless/combat_bench.ts",
    "world:tour": "tsx src/headless/traversal_tour.ts",
    "audit:deps": "npm audit --audit-level=moderate",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "standalone": "vite build && node scripts/make_standalone.mjs",
    "gate": "npm run validate && npm run typecheck && vitest run && vite build"
  },
  "dependencies": {
    "three": "^0.165.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.165.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
